# Copy this file to `.env` and fill in your key. The notebooks' portable setup
# cell loads it automatically when running locally (via python-dotenv). On
# Google Colab, set the same names in the "Secrets" panel instead of using .env.

OPENAI_API_KEY=sk-your-key-here

# Optional — only needed to use an OpenAI-compatible gateway instead of the
# standard OpenAI endpoint. Leave commented for normal OpenAI usage.
# OPENAI_BASE_URL=https://your-gateway/v1
# OPENAI_MODEL=gpt-4o-mini
